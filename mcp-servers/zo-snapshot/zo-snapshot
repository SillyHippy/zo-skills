#!/usr/bin/env python3
"""
zo-snapshot v3.1: Fast Content-Addressable (CAS) + Stat-Cached Full VPS Snapshot Engine.
- Live files are NEVER hardlinked (live in-place edits never mutate snapshots).
- Snapshot files link to immutable objects in the CAS pool (/root/.zo_snapshots/objects/).
- Mtime + Size stat-caching avoids re-reading/re-hashing untouched files in huge projects.
- Atomic restore via staged temporary files and os.replace.
- Full GitHub-compliant unified diffs (including added /dev/null and deleted /dev/null hunks).
"""

import os
import sys
import re
import json
import time
import shutil
import sqlite3
import hashlib
import difflib
import argparse
from pathlib import Path
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs
from datetime import datetime

SNAPSHOT_ROOT = Path("/root/.zo_snapshots")
SNAPSHOT_DATA = SNAPSHOT_ROOT / "data"
SNAPSHOT_OBJECTS = SNAPSHOT_ROOT / "objects"
DB_PATH = SNAPSHOT_ROOT / "snapshots.db"

ID_REGEX = re.compile(r"^snap_[0-9]{8}_[0-9]{6}_[a-f0-9]{6,12}$")

DEFAULT_EXCLUDES = {
    "node_modules", ".git", ".cache", "__pycache__", ".venv", "venv",
    ".npm", ".pnpm-store", "dist", "build", ".next", ".turbo",
    ".zo_snapshots", ".tmp_rst"
}

FULL_VPS_ROOTS = [
    "/home/workspace",
    "/root",
    "/etc/zo",
    "/tmp"
]

SCOPE_PATHS = {
    "vps": FULL_VPS_ROOTS,
    "all": FULL_VPS_ROOTS,
    "workspace": ["/home/workspace"],
    "root": ["/root"],
    "config": [
        "/root/.hermes/config.yaml",
        "/root/.hermes/skills",
        "/root/.hermes/cron",
        "/etc/zo/supervisord-user.conf",
        "/etc/zo/supervisor.conf",
        "/root/.zo_secrets"
    ],
    "hermes": ["/root/.hermes"]
}

def init_db(root_path: Path = SNAPSHOT_ROOT):
    root_path.mkdir(parents=True, exist_ok=True)
    (root_path / "data").mkdir(parents=True, exist_ok=True)
    (root_path / "objects").mkdir(parents=True, exist_ok=True)
    db_file = root_path / "snapshots.db"
    conn = sqlite3.connect(str(db_file))
    with conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS snapshots (
                id TEXT PRIMARY KEY,
                label TEXT,
                scope TEXT,
                created_at TIMESTAMP,
                file_count INTEGER,
                total_bytes INTEGER,
                metadata_json TEXT
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS file_cache (
                path TEXT PRIMARY KEY,
                size INTEGER,
                mtime REAL,
                sha256 TEXT
            )
        """)
    return conn

def get_db(root_path: Path = SNAPSHOT_ROOT):
    return sqlite3.connect(str(root_path / "snapshots.db"))

def validate_id(snap_id: str) -> bool:
    return bool(ID_REGEX.match(snap_id))

def should_exclude(path_obj: Path) -> bool:
    parts = path_obj.parts
    for part in parts:
        if part in DEFAULT_EXCLUDES:
            return True
        if part.startswith(".tmp_rst_"):
            return True
        if part.endswith(".pyc") or part.endswith(".sock"):
            return True
    return False

def hash_file(filepath: Path) -> str:
    h = hashlib.sha256()
    with open(filepath, 'rb') as f:
        while chunk := f.read(131072):
            h.update(chunk)
    return h.hexdigest()

def get_or_calc_hash(filepath: Path, st, cache_map: dict) -> str:
    fkey = str(filepath)
    cached = cache_map.get(fkey)
    if cached and cached["size"] == st.st_size and abs(cached["mtime"] - st.st_mtime) < 0.0001:
        return cached["sha256"]
    sha = hash_file(filepath)
    cache_map[fkey] = {"size": st.st_size, "mtime": st.st_mtime, "sha256": sha}
    return sha

def store_cas_object(src_file: Path, sha: str, root_path: Path = SNAPSHOT_ROOT) -> Path:
    obj_dir = (root_path / "objects") / sha[:2]
    obj_dir.mkdir(parents=True, exist_ok=True)
    obj_file = obj_dir / sha[2:]
    
    if not obj_file.exists():
        tmp_obj = obj_dir / f".tmp_{os.getpid()}_{sha[2:]}"
        shutil.copy2(src_file, tmp_obj)
        os.chmod(tmp_obj, 0o444)
        os.replace(tmp_obj, obj_file)
    return obj_file

def scan_live_files(roots: list) -> tuple[dict, list]:
    files_map = {}
    errors = []
    
    for r_str in roots:
        r_path = Path(r_str).resolve()
        if not r_path.exists():
            continue
            
        if r_path.is_file():
            if should_exclude(r_path) or r_path.is_symlink():
                continue
            try:
                st = r_path.stat()
                sha = hash_file(r_path)
                files_map[str(r_path)] = {
                    "size": st.st_size,
                    "mtime": st.st_mtime,
                    "sha256": sha,
                    "mode": oct(st.st_mode)
                }
            except Exception as e:
                errors.append({"path": str(r_path), "error": str(e)})
        elif r_path.is_dir():
            for root, dirs, files in os.walk(r_path):
                dirs[:] = [d for d in dirs if not should_exclude(Path(root) / d)]
                for f in files:
                    src_file = Path(root) / f
                    if should_exclude(src_file) or src_file.is_symlink():
                        continue
                    try:
                        st = src_file.stat()
                        sha = hash_file(src_file)
                        files_map[str(src_file)] = {
                            "size": st.st_size,
                            "mtime": st.st_mtime,
                            "sha256": sha,
                            "mode": oct(st.st_mode)
                        }
                    except Exception as e:
                        errors.append({"path": str(src_file), "error": str(e)})
    return files_map, errors

def create_snapshot(label: str = "", scope: str = "vps", custom_paths: list = None, root_path: Path = SNAPSHOT_ROOT) -> dict:
    init_db(root_path)
    ts = datetime.now()
    snap_id = f"snap_{ts.strftime('%Y%m%d_%H%M%S')}_{os.urandom(4).hex()}"
    snap_dir = (root_path / "data") / snap_id
    temp_dir = (root_path / "data") / f".tmp_{snap_id}"
    
    targets = [str(Path(p).resolve()) for p in (custom_paths if custom_paths else SCOPE_PATHS.get(scope, FULL_VPS_ROOTS))]
    temp_dir.mkdir(parents=True, exist_ok=True)
    
    cache_map = {}
    with get_db(root_path) as conn:
        for r in conn.execute("SELECT path, size, mtime, sha256 FROM file_cache").fetchall():
            cache_map[r[0]] = {"size": r[1], "mtime": r[2], "sha256": r[3]}

    manifest = {
        "id": snap_id,
        "label": label or f"Snapshot {ts.strftime('%Y-%m-%d %H:%M:%S')}",
        "scope": "custom" if custom_paths else scope,
        "roots": targets,
        "created_at": ts.isoformat(),
        "files": {},
        "warnings": []
    }

    file_count = 0
    total_bytes = 0

    try:
        for target_str in targets:
            target_path = Path(target_str)
            if not target_path.exists():
                continue

            if target_path.is_file():
                if should_exclude(target_path) or target_path.is_symlink():
                    continue
                try:
                    st = target_path.stat()
                    sha = get_or_calc_hash(target_path, st, cache_map)
                    obj_file = store_cas_object(target_path, sha, root_path)
                    
                    rel_path = target_path.relative_to("/")
                    dest = temp_dir / rel_path
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    os.link(obj_file, dest)
                    
                    file_count += 1
                    total_bytes += st.st_size
                    manifest["files"][str(target_path)] = {
                        "size": st.st_size,
                        "mtime": st.st_mtime,
                        "sha256": sha,
                        "mode": oct(st.st_mode)
                    }
                except Exception as e:
                    manifest["warnings"].append({"path": str(target_path), "error": str(e)})

            elif target_path.is_dir():
                for root, dirs, files in os.walk(target_path):
                    dirs[:] = [d for d in dirs if not should_exclude(Path(root) / d)]
                    
                    for f in files:
                        src_file = Path(root) / f
                        if should_exclude(src_file) or src_file.is_symlink():
                            continue
                        
                        try:
                            st = src_file.stat()
                            sha = get_or_calc_hash(src_file, st, cache_map)
                            obj_file = store_cas_object(src_file, sha, root_path)
                            
                            rel_path = src_file.relative_to("/")
                            dest = temp_dir / rel_path
                            dest.parent.mkdir(parents=True, exist_ok=True)
                            os.link(obj_file, dest)
                            
                            file_count += 1
                            total_bytes += st.st_size
                            manifest["files"][str(src_file)] = {
                                "size": st.st_size,
                                "mtime": st.st_mtime,
                                "sha256": sha,
                                "mode": oct(st.st_mode)
                            }
                        except Exception as e:
                            manifest["warnings"].append({"path": str(src_file), "error": str(e)})

        with open(temp_dir / "manifest.json", "w") as mf:
            json.dump(manifest, mf, indent=2)

        temp_dir.rename(snap_dir)

        with get_db(root_path) as conn:
            conn.execute("""
                INSERT INTO snapshots (id, label, scope, created_at, file_count, total_bytes, metadata_json)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            """, (snap_id, manifest["label"], manifest["scope"], ts.isoformat(), file_count, total_bytes, json.dumps(manifest)))
            
            cache_rows = [(p, v["size"], v["mtime"], v["sha256"]) for p, v in cache_map.items()]
            conn.executemany("""
                INSERT OR REPLACE INTO file_cache (path, size, mtime, sha256) VALUES (?, ?, ?, ?)
            """, cache_rows)

        return {
            "id": snap_id,
            "label": manifest["label"],
            "scope": manifest["scope"],
            "roots": targets,
            "created_at": ts.isoformat(),
            "file_count": file_count,
            "total_bytes": total_bytes,
            "warnings_count": len(manifest["warnings"])
        }
    except Exception as e:
        if temp_dir.exists():
            shutil.rmtree(temp_dir, ignore_errors=True)
        raise RuntimeError(f"Failed to create snapshot: {e}")

def list_snapshots(root_path: Path = SNAPSHOT_ROOT) -> list:
    init_db(root_path)
    with get_db(root_path) as conn:
        conn.row_factory = sqlite3.Row
        cur = conn.execute("SELECT id, label, scope, created_at, file_count, total_bytes FROM snapshots ORDER BY created_at DESC")
        rows = [dict(r) for r in cur.fetchall()]
    return rows

def get_snapshot(snap_id: str, root_path: Path = SNAPSHOT_ROOT) -> dict:
    if not validate_id(snap_id):
        return None
    init_db(root_path)
    with get_db(root_path) as conn:
        conn.row_factory = sqlite3.Row
        cur = conn.execute("SELECT * FROM snapshots WHERE id = ?", (snap_id,))
        row = cur.fetchone()
        if not row:
            return None
        res = dict(row)
        if res.get("metadata_json"):
            res["manifest"] = json.loads(res["metadata_json"])
        return res

def delete_snapshot(snap_id: str, root_path: Path = SNAPSHOT_ROOT) -> bool:
    if not validate_id(snap_id):
        return False
    init_db(root_path)
    
    with get_db(root_path) as conn:
        cur = conn.execute("SELECT id FROM snapshots WHERE id = ?", (snap_id,))
        if not cur.fetchone():
            return False
            
    snap_dir = (root_path / "data") / snap_id
    if snap_dir.resolve().parent != (root_path / "data").resolve():
        return False
        
    if snap_dir.exists():
        shutil.rmtree(snap_dir, ignore_errors=True)
        
    with get_db(root_path) as conn:
        conn.execute("DELETE FROM snapshots WHERE id = ?", (snap_id,))
    return True

def diff_snapshots(snap_id_1: str, snap_id_2: str = "current", max_diff_lines: int = 500, root_path: Path = SNAPSHOT_ROOT) -> dict:
    if not validate_id(snap_id_1):
        return {"error": f"Invalid source snapshot ID: {snap_id_1}"}
        
    s1 = get_snapshot(snap_id_1, root_path)
    if not s1:
        return {"error": f"Snapshot {snap_id_1} not found"}
    
    manifest1 = s1.get("manifest", {})
    m1 = manifest1.get("files", {})
    roots1 = manifest1.get("roots", SCOPE_PATHS.get(s1.get("scope"), FULL_VPS_ROOTS))
    snap_dir_1 = (root_path / "data") / snap_id_1

    m2 = {}
    snap_dir_2 = None
    is_live_current = (snap_id_2 in ("current", "live", "", None))

    if not is_live_current:
        if not validate_id(snap_id_2):
            return {"error": f"Invalid target snapshot ID: {snap_id_2}"}
        s2 = get_snapshot(snap_id_2, root_path)
        if not s2:
            return {"error": f"Snapshot {snap_id_2} not found"}
        m2 = s2.get("manifest", {}).get("files", {})
        snap_dir_2 = (root_path / "data") / snap_id_2
    else:
        live_scanned, _ = scan_live_files(roots1)
        m2 = live_scanned

    all_files = sorted(set(list(m1.keys()) + list(m2.keys())))
    added = []
    deleted = []
    modified = []
    unchanged = []
    diffs = {}

    for fpath in all_files:
        in_1 = fpath in m1
        in_2 = fpath in m2
        clean_path = fpath.lstrip("/")

        if not in_1 and in_2:
            # Brand new added file: diff against /dev/null
            added.append(fpath)
            if is_live_current:
                f2_disk = Path(fpath)
            else:
                f2_disk = snap_dir_2 / Path(clean_path)
            try:
                t2 = f2_disk.read_text(errors="replace").splitlines(keepends=True)
                udiff = list(difflib.unified_diff(
                    [], t2,
                    fromfile="/dev/null",
                    tofile=f"b/{clean_path}",
                    n=3
                ))
                if udiff:
                    diffs[fpath] = "".join(udiff[:max_diff_lines])
            except Exception as ex:
                diffs[fpath] = f"[Binary or unreadable file: {ex}]"

        elif in_1 and not in_2:
            # Deleted file: diff from snapshot to /dev/null
            deleted.append(fpath)
            f1_disk = snap_dir_1 / Path(clean_path)
            try:
                t1 = f1_disk.read_text(errors="replace").splitlines(keepends=True)
                udiff = list(difflib.unified_diff(
                    t1, [],
                    fromfile=f"a/{clean_path}",
                    tofile="/dev/null",
                    n=3
                ))
                if udiff:
                    diffs[fpath] = "".join(udiff[:max_diff_lines])
            except Exception as ex:
                diffs[fpath] = f"[Binary or unreadable file: {ex}]"

        else:
            # In both: check if modified
            if m1[fpath]["sha256"] != m2[fpath]["sha256"]:
                modified.append(fpath)
                f1_disk = snap_dir_1 / Path(clean_path)
                if is_live_current:
                    f2_disk = Path(fpath)
                else:
                    f2_disk = snap_dir_2 / Path(clean_path)

                try:
                    t1 = f1_disk.read_text(errors="replace").splitlines(keepends=True)
                    t2 = f2_disk.read_text(errors="replace").splitlines(keepends=True)
                    udiff = list(difflib.unified_diff(
                        t1, t2,
                        fromfile=f"a/{clean_path}",
                        tofile=f"b/{clean_path}",
                        n=3
                    ))
                    if udiff:
                        diffs[fpath] = "".join(udiff[:max_diff_lines])
                except Exception as ex:
                    diffs[fpath] = f"[Binary or unreadable file diff: {ex}]"
            else:
                unchanged.append(fpath)

    return {
        "from": snap_id_1,
        "to": "current_live" if is_live_current else snap_id_2,
        "summary": {
            "added_count": len(added),
            "modified_count": len(modified),
            "deleted_count": len(deleted),
            "unchanged_count": len(unchanged)
        },
        "added": added,
        "modified": modified,
        "deleted": deleted,
        "diffs": diffs
    }

def restore_snapshot(snap_id: str, dry_run: bool = False, target_file: str = None, root_path: Path = SNAPSHOT_ROOT) -> dict:
    if not validate_id(snap_id):
        return {"error": f"Invalid snapshot ID: {snap_id}"}
        
    s = get_snapshot(snap_id, root_path)
    if not s:
        return {"error": f"Snapshot {snap_id} not found"}

    snap_dir = (root_path / "data") / snap_id
    manifest = s.get("manifest", {})
    files = manifest.get("files", {})
    roots = manifest.get("roots", SCOPE_PATHS.get(s.get("scope"), FULL_VPS_ROOTS))
    
    # 1. Full pre-flight SHA256 integrity check over stored files
    integrity_errors = []
    for fpath_str, meta in files.items():
        src_disk = snap_dir / Path(fpath_str).relative_to("/")
        if not src_disk.exists():
            integrity_errors.append(f"Missing snapshot storage file: {fpath_str}")
        elif hash_file(src_disk) != meta.get("sha256"):
            integrity_errors.append(f"Corrupted snapshot storage file: {fpath_str}")
            
    if integrity_errors:
        return {"error": "Snapshot integrity check failed", "details": integrity_errors}

    # 2. Automatic safety checkpoint of live files before touching anything
    safety_id = None
    if not dry_run:
        safety_snap = create_snapshot(
            label=f"Auto-safety before restore of {snap_id}",
            scope="custom",
            custom_paths=roots,
            root_path=root_path
        )
        safety_id = safety_snap["id"]

    actions = []
    staged_transfers = []

    for fpath_str, meta in files.items():
        if target_file and fpath_str != target_file and not fpath_str.startswith(target_file):
            continue

        src_disk = snap_dir / Path(fpath_str).relative_to("/")
        dest_path = Path(fpath_str)
        action = "overwrite" if dest_path.exists() else "create"
        actions.append({"file": fpath_str, "action": action, "size": meta.get("size", 0)})

        if not dry_run:
            dest_path.parent.mkdir(parents=True, exist_ok=True)
            temp_target = dest_path.with_name(f".tmp_rst_{os.getpid()}_{dest_path.name}")
            shutil.copy2(src_disk, temp_target)
            os.chmod(temp_target, int(meta.get("mode", "0o644"), 8))
            staged_transfers.append((temp_target, dest_path))

    # Apply staged replacements atomically
    if not dry_run:
        for temp_target, dest_path in staged_transfers:
            os.replace(temp_target, dest_path)

    return {
        "restored_from": snap_id,
        "dry_run": dry_run,
        "safety_snapshot_id": safety_id,
        "restored_count": len(actions),
        "actions": actions
    }

# ================= HTTP / MCP Server =================

class SnapshotHandler(BaseHTTPRequestHandler):
    root_path = SNAPSHOT_ROOT

    def send_json(self, data, status=200):
        body = json.dumps(data, indent=2).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "http://127.0.0.1")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "http://127.0.0.1")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.end_headers()

    def do_GET(self):
        parsed = urlparse(self.path)
        qs = parse_qs(parsed.query)

        if parsed.path in ("/", "/ui", "/snapshot", "/snapshot/"):
            ui_html = Path("/root/snapshot_ui.html").read_bytes()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(ui_html)))
            self.end_headers()
            self.wfile.write(ui_html)
            return

        if parsed.path in ("/api/snapshots", "/snapshots", "/snapshot/api/snapshots"):
            self.send_json(list_snapshots(self.root_path))
        elif (parsed.path.startswith("/api/snapshots/diff") or parsed.path.startswith("/snapshot/api/snapshots/diff")):
            from_id = qs.get("from", [""])[0]
            to_id = qs.get("to", ["current"])[0]
            if not from_id:
                self.send_json({"error": "Missing 'from' parameter"}, 400)
            else:
                self.send_json(diff_snapshots(from_id, to_id, root_path=self.root_path))
        elif parsed.path.startswith("/api/snapshots/"):
            snap_id = parsed.path.replace("/api/snapshots/", "").strip("/")
            snap = get_snapshot(snap_id, self.root_path)
            if snap:
                self.send_json(snap)
            else:
                self.send_json({"error": "Not found"}, 404)
        elif parsed.path == "/health":
            self.send_json({"status": "ok", "service": "zo-snapshot", "version": "3.1.0"})
        else:
            self.send_json({"error": "Not Found"}, 404)

    def do_POST(self):
        parsed = urlparse(self.path)
        length = int(self.headers.get("Content-Length", 0))
        body = json.loads(self.rfile.read(length).decode("utf-8")) if length > 0 else {}

        if parsed.path in ("/api/snapshots", "/snapshots", "/snapshot/api/snapshots"):
            label = body.get("label", "")
            scope = body.get("scope", "vps")
            custom_paths = body.get("paths", None)
            res = create_snapshot(label=label, scope=scope, custom_paths=custom_paths, root_path=self.root_path)
            self.send_json(res, 201)
        elif parsed.path in ("/api/snapshots/restore", "/restore", "/snapshot/api/snapshots/restore"):
            snap_id = body.get("id")
            dry_run = body.get("dry_run", False)
            target_file = body.get("target_file", None)
            if not snap_id:
                self.send_json({"error": "Missing 'id'"}, 400)
            else:
                self.send_json(restore_snapshot(snap_id, dry_run=dry_run, target_file=target_file, root_path=self.root_path))
        elif parsed.path in ("/mcp", "/mcp/"):
            self.handle_mcp(body)
        else:
            self.send_json({"error": "Not Found"}, 404)

    def do_DELETE(self):
        parsed = urlparse(self.path)
        if parsed.path.startswith("/api/snapshots/"):
            snap_id = parsed.path.replace("/api/snapshots/", "").strip("/")
            ok = delete_snapshot(snap_id, self.root_path)
            self.send_json({"success": ok, "id": snap_id})
        else:
            self.send_json({"error": "Not Found"}, 404)

    def handle_mcp(self, body):
        method = body.get("method")
        msg_id = body.get("id", 1)

        if method == "initialize":
            self.send_json({
                "jsonrpc": "2.0",
                "id": msg_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "serverInfo": {"name": "zo-snapshot", "version": "3.1.0"},
                    "capabilities": {"tools": {}}
                }
            })
        elif method == "notifications/initialized":
            self.send_json({"jsonrpc": "2.0", "result": {}})
        elif method == "tools/list":
            tools = [
                {
                    "name": "snapshot_list",
                    "description": "List all workspace, system, and configuration snapshots with timestamps and labels.",
                    "inputSchema": {"type": "object", "properties": {}}
                },
                {
                    "name": "snapshot_create",
                    "description": "Create a full VPS snapshot (workspace, root, etc, tmp) or custom scope.",
                    "inputSchema": {
                        "type": "object",
                        "properties": {
                            "label": {"type": "string", "description": "Human-readable label"},
                            "scope": {"type": "string", "enum": ["vps", "all", "workspace", "root", "config", "hermes", "custom"], "default": "vps"},
                            "paths": {"type": "array", "items": {"type": "string"}, "description": "Custom paths list"}
                        }
                    }
                },
                {
                    "name": "snapshot_diff",
                    "description": "Compare two snapshots or compare a snapshot against current live state.",
                    "inputSchema": {
                        "type": "object",
                        "properties": {
                            "from_id": {"type": "string", "description": "Source snapshot ID"},
                            "to_id": {"type": "string", "description": "Target snapshot ID (or 'current')", "default": "current"}
                        },
                        "required": ["from_id"]
                    }
                },
                {
                    "name": "snapshot_restore",
                    "description": "Restore files from a snapshot back to the live system with auto-safety checkpoint.",
                    "inputSchema": {
                        "type": "object",
                        "properties": {
                            "id": {"type": "string", "description": "Snapshot ID to restore"},
                            "dry_run": {"type": "boolean", "default": False}
                        },
                        "required": ["id"]
                    }
                }
            ]
            self.send_json({"jsonrpc": "2.0", "id": msg_id, "result": {"tools": tools}})
        elif method == "tools/call":
            params = body.get("params", {})
            tool_name = params.get("name")
            args = params.get("arguments", {})

            if tool_name == "snapshot_list":
                res = list_snapshots(self.root_path)
            elif tool_name == "snapshot_create":
                res = create_snapshot(label=args.get("label", ""), scope=args.get("scope", "vps"), custom_paths=args.get("paths"), root_path=self.root_path)
            elif tool_name == "snapshot_diff":
                res = diff_snapshots(args.get("from_id"), args.get("to_id", "current"), root_path=self.root_path)
            elif tool_name == "snapshot_restore":
                res = restore_snapshot(args.get("id"), dry_run=args.get("dry_run", False), root_path=self.root_path)
            else:
                res = {"error": f"Unknown tool {tool_name}"}

            self.send_json({
                "jsonrpc": "2.0",
                "id": msg_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(res, indent=2)}]
                }
            })
        else:
            self.send_json({"jsonrpc": "2.0", "id": msg_id, "error": {"code": -32601, "message": "Method not found"}})

    def log_message(self, format, *args):
        pass

def run_server(port: int = 3090, root_path: Path = SNAPSHOT_ROOT):
    init_db(root_path)
    SnapshotHandler.root_path = root_path
    server = HTTPServer(("127.0.0.1", port), SnapshotHandler)
    print(f"zo-snapshot v3.1 running on http://127.0.0.1:{port} (MCP at /mcp)")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass

def main():
    parser = argparse.ArgumentParser(description="zo-snapshot: Full-VPS Snapshot & Diff Engine for Zo Computer")
    subparsers = parser.add_subparsers(dest="command", help="Commands")

    p_create = subparsers.add_parser("create", help="Create a snapshot")
    p_create.add_argument("label", nargs="?", default="", help="Snapshot label")
    p_create.add_argument("--scope", default="vps", choices=["vps", "all", "workspace", "root", "config", "hermes", "custom"], help="Scope to snapshot (default: vps = full VPS)")
    p_create.add_argument("--paths", nargs="+", help="Specific custom paths to snapshot")
    p_create.add_argument("--json", action="store_true", help="Output JSON")

    p_list = subparsers.add_parser("list", help="List snapshots")
    p_list.add_argument("--json", action="store_true", help="Output JSON")

    p_diff = subparsers.add_parser("diff", help="Diff snapshot against live or another snapshot")
    p_diff.add_argument("from_id", help="Source snapshot ID")
    p_diff.add_argument("to_id", nargs="?", default="current", help="Target snapshot ID (default: current live)")
    p_diff.add_argument("--json", action="store_true", help="Output JSON")
    p_diff.add_argument("--stat", action="store_true", help="Show summary statistics only")

    p_restore = subparsers.add_parser("restore", help="Restore a snapshot")
    p_restore.add_argument("id", help="Snapshot ID to restore")
    p_restore.add_argument("--dry-run", action="store_true", help="Simulate restore without touching files")
    p_restore.add_argument("--json", action="store_true", help="Output JSON")

    p_info = subparsers.add_parser("info", help="Get snapshot info")
    p_info.add_argument("id", help="Snapshot ID")
    p_info.add_argument("--json", action="store_true", help="Output JSON")

    p_del = subparsers.add_parser("delete", help="Delete a snapshot")
    p_del.add_argument("id", help="Snapshot ID")

    p_serve = subparsers.add_parser("serve", help="Run HTTP / MCP server")
    p_serve.add_argument("--port", type=int, default=3090, help="Port to listen on")

    args = parser.parse_args()

    if not args.command or args.command == "list":
        snaps = list_snapshots()
        if getattr(args, "json", False):
            print(json.dumps(snaps, indent=2))
        else:
            if not snaps:
                print("No snapshots found. Run `zo-snapshot create [label]` to take one.")
            else:
                print(f"{'ID':<34} {'CREATED':<20} {'SCOPE':<10} {'FILES':<8} {'LABEL'}")
                print("-" * 92)
                for s in snaps:
                    dt = s["created_at"].split(".")[0].replace("T", " ")
                    print(f"{s['id']:<34} {dt:<20} {s['scope']:<10} {s['file_count']:<8} {s['label']}")

    elif args.command == "create":
        res = create_snapshot(label=args.label, scope=args.scope, custom_paths=args.paths)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"✓ Snapshot created: {res['id']}")
            print(f"  Label: {res['label']}")
            print(f"  Scope: {res['scope']} ({res['file_count']} files, {res['total_bytes'] / 1024:.1f} KB)")
            if res.get("warnings_count", 0) > 0:
                print(f"  Warnings: {res['warnings_count']} unreadable files skipped")

    elif args.command == "diff":
        res = diff_snapshots(args.from_id, args.to_id)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            if "error" in res:
                print(f"Error: {res['error']}")
                sys.exit(1)
            summary = res["summary"]
            print(f"Comparing: {res['from']} ➔ {res['to']}")
            print(f"Summary: +{summary['added_count']} added, ~{summary['modified_count']} modified, -{summary['deleted_count']} deleted, {summary['unchanged_count']} unchanged")
            print()
            if res["added"]:
                print("Added files:")
                for f in res["added"]:
                    print(f"  + {f}")
            if res["deleted"]:
                print("Deleted files:")
                for f in res["deleted"]:
                    print(f"  - {f}")
            if res["modified"]:
                print("Modified files:")
                for f in res["modified"]:
                    print(f"  ~ {f}")
            
            if not args.stat and res["diffs"]:
                print("\n" + "=" * 60 + " UNIFIED DIFFS " + "=" * 60)
                for fpath, d in res["diffs"].items():
                    print(f"\n--- {fpath} ---")
                    print(d)

    elif args.command == "restore":
        res = restore_snapshot(args.id, dry_run=args.dry_run)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            if "error" in res:
                print(f"Error: {res['error']}")
                if "details" in res:
                    for d in res["details"]:
                        print(f"  - {d}")
                sys.exit(1)
            prefix = "[DRY-RUN] " if res["dry_run"] else ""
            print(f"{prefix}Restored {res['restored_count']} files from {res['restored_from']}")
            if res.get("safety_snapshot_id"):
                print(f"Safety snapshot created: {res['safety_snapshot_id']}")
            for act in res["actions"]:
                print(f"  [{act['action']}] {act['file']}")

    elif args.command == "info":
        snap = get_snapshot(args.id)
        if not snap:
            print(f"Snapshot {args.id} not found.")
            sys.exit(1)
        if args.json:
            print(json.dumps(snap, indent=2))
        else:
            print(f"Snapshot ID: {snap['id']}")
            print(f"Label:       {snap['label']}")
            print(f"Scope:       {snap['scope']}")
            print(f"Created At:  {snap['created_at']}")
            print(f"Files:       {snap['file_count']}")
            print(f"Total Size:  {snap['total_bytes'] / 1024:.2f} KB")

    elif args.command == "delete":
        ok = delete_snapshot(args.id)
        print(f"Deleted snapshot {args.id}" if ok else f"Snapshot {args.id} not found or invalid.")

    elif args.command == "serve":
        run_server(args.port)

if __name__ == "__main__":
    main()
